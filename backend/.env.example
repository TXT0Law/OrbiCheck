APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orbicheck
REDIS_URL=redis://localhost:6379/0
SCAN_SERVICE_URL=http://localhost:4000
CORS_ORIGINS=["http://localhost:3000"]
AUTH_LOGIN_EMAIL=admin@orbicheck.local
AUTH_LOGIN_PASSWORD=change-me
AUTH_SESSION_SECRET=change-me-to-a-long-random-secret
AUTH_COOKIE_SECURE=false
EMAIL_DISPATCH_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=OrbiCheck Alerts
SMTP_USE_TLS=true
