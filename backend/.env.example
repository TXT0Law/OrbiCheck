APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orbicheck
REDIS_URL=redis://localhost:6379/0
SCAN_SERVICE_URL=http://localhost:4000
CORS_ORIGINS=["http://localhost:3000"]
AUTH_LOGIN_EMAIL=admin@orbicheck.local
AUTH_LOGIN_PASSWORD=change-me
AUTH_SESSION_SECRET=change-me-to-a-long-random-secret
AUTH_COOKIE_SECURE=false
# Effective only when APP_ENV=development; production always keeps auth enabled.
AUTH_DEV_BYPASS_ENABLED=true
EMAIL_DISPATCH_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=OrbiCheck Alerts
SMTP_USE_TLS=true

# ── Monitor: visual_change (V-1 / V-2) ──────────────────────────────
# When True, capture screenshots even when the HTTP probe fails (bot wall,
# 5xx, TLS error). Captured rows are flagged is_diagnostic=True so they
# never poison the dHash similarity baseline.
# (Per-monitor override lives in capabilities.visual_change.thresholds.captureOnFailure.)
# MONITOR_MAX_DIAGNOSTIC_CAPTURES_PER_MONITOR=10

# V-2: per-monitor rate limit for POST /monitors/{id}/visual/captures/now
# MONITOR_VISUAL_CAPTURE_NOW_WINDOW_SECONDS=60
# MONITOR_VISUAL_CAPTURE_NOW_MAX_PER_WINDOW=5

# C-1: enable CSS selector extraction for content_change (default True).
# Per-monitor selectors live in capabilities.content_change.thresholds.selectorExtraction.
# CONTENT_SELECTOR_EXTRACTION_ENABLED=true
