{
  "name": "orbicheck-scan-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"if(!process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD&&!process.env.SKIP_PLAYWRIGHT_INSTALL){require('child_process').execSync('npx playwright install chromium',{stdio:'inherit'})}else{console.log('[orbicheck] Skipping playwright browser download (PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD or SKIP_PLAYWRIGHT_INSTALL set).')}\"",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --ext .js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "test:handles": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "test:live": "cross-env NODE_ENV=test SCAN_LIVE_TEST=1 NODE_OPTIONS=--experimental-vm-modules jest --config jest.live.config.js --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.2.0",
    "csv-parser": "^3.2.0",
    "express": "^4.21.0",
    "follow-redirects": "^1.15.11",
    "got": "^14.6.6",
    "helmet": "^8.1.0",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "prom-client": "^15.1.3",
    "psl": "^1.15.0",
    "unzipper": "^0.12.3",
    "url-parse": "^1.5.10",
    "uuid": "^13.0.0",
    "wappalyzer": "^7.0.3",
    "whois": "^2.16.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  }
}
