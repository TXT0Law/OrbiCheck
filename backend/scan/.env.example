# Scan Service environment variables
# Copy to .env and fill in values as needed.

# Optional: extra IP geolocation after ip-api.com + ipwho.is (https://ipinfo.io)
# IPINFO_TOKEN=

# Optional: per-module timeouts (batch). tech-stack uses the extended budget for Wappalyzer + header fallback.
# EXTENDED_MODULE_TIMEOUT_MS=60000

# S-1: per-host circuit breaker (in-process). After N consecutive failures
# (5xx / network / timeout) the breaker opens for COOLDOWN_MS so subsequent
# scan modules fail-fast against the same hostname instead of paying the
# full module timeout each.
# SCAN_CIRCUIT_BREAKER_ENABLED=true
# SCAN_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# SCAN_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# S-2: retry policy for the shared axios instance (`_common/http.js`).
# `SCAN_HTTP_RETRY_COUNT=0` disables retries entirely. By default 5xx is
# NOT retried (set SCAN_HTTP_RETRY_5XX=true to opt back in); 429 is still
# retried, honouring the upstream `Retry-After` header.
# SCAN_HTTP_RETRY_COUNT=2
# SCAN_HTTP_RETRY_BASE_MS=300
# SCAN_HTTP_RETRY_5XX=false

# S-7: per-host module concurrency. The runner gates concurrent module
# invocations against the same hostname so a 30-module batch can't fan
# out 30 sockets at once against a CDN / WAF.
# SCAN_HOST_CONCURRENCY=6

# Screenshot uses Playwright's bundled Chromium. Run: npx playwright install chromium
# Optional: override browser cache directory
# PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers

# BuiltWith API key for Site Features detection. Get one at https://builtwith.com/
# If unset, features fall back to tech-stack (Wappalyzer) when available.
# BUILT_WITH_API_KEY=your-api-key
