# Scan Service environment variables
# Copy to .env and fill in values as needed.

# Optional: extra IP geolocation after ip-api.com + ipwho.is (https://ipinfo.io)
# IPINFO_TOKEN=

# Optional: per-module timeouts (batch). tech-stack uses the extended budget for Wappalyzer + header fallback.
# EXTENDED_MODULE_TIMEOUT_MS=60000

# Screenshot uses Playwright's bundled Chromium. Run: npx playwright install chromium
# Optional: override browser cache directory
# PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers

# BuiltWith API key for Site Features detection. Get one at https://builtwith.com/
# If unset, features fall back to tech-stack (Wappalyzer) when available.
# BUILT_WITH_API_KEY=your-api-key
