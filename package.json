{
  "name": "orbicheck",
  "version": "0.1.0",
  "private": true,
  "description": "External-perspective website security assessment platform with 30+ OSINT reconnaissance modules, AI-powered analysis, and continuous monitoring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TXT0Law/OrbiCheck.git"
  },
  "homepage": "https://github.com/TXT0Law/OrbiCheck#readme",
  "bugs": {
    "url": "https://github.com/TXT0Law/OrbiCheck/issues"
  },
  "keywords": [
    "osint",
    "web-security",
    "reconnaissance",
    "security-assessment",
    "vulnerability-scanner",
    "dns",
    "ssl",
    "website-analysis"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:linked": "playwright test --config=playwright.config.ts && playwright test --config=playwright.backend-down.config.ts",
    "test:linked:headed": "playwright test --config=playwright.config.ts --headed && playwright test --config=playwright.backend-down.config.ts --headed",
    "test:linked:ci": "playwright test --config=playwright.config.ts --reporter=list,html && playwright test --config=playwright.backend-down.config.ts --reporter=list,html"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18",
    "react-diff-viewer-continued": "^4.2.0",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
