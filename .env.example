# OrbiCheck — Root Environment Variables
# Copy this file to .env.local for Next.js frontend configuration.
# For backend config, see backend/.env.example
# For scan service config, see backend/scan/.env.example

# ── Frontend (Next.js) ──────────────────────────────────────────

# Backend API URL (used by the frontend to reach the FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Monitor feature flags (optional)
# NEXT_PUBLIC_MONITOR_USE_MOCK=0
# NEXT_PUBLIC_MONITOR_CHANGES_EXPORT_PDF=0
